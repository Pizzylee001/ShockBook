# RYO-CHAN MCP Server Configuration
RYO_MCP_URL=https://app-ryochan.com/api/mcp
RYO_MCP_KEY=ryo_mcp_your_key_here

# River AI OpenAI-Compatible LLM Configuration
RIVER_BASE_URL=https://api.river.ai/v1
